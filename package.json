{
  "name": "persian-magic-alphabet-board",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "android:add": "npm run build && npx cap add android && node scripts/patch-android.mjs",
    "android:sync": "npm run build && npx cap sync android && node scripts/patch-android.mjs",
    "android:open": "npx cap open android",
    "assets:generate": "capacitor-assets generate --android",
    "release:check": "npm run lint && npm run build",
    "release:android:win": "scripts\\build-release.cmd",
    "release:android": "bash scripts/build-release.sh",
    "android:patch": "node scripts/patch-android.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "@capacitor/core": "^7.4.0",
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "@capacitor-community/text-to-speech": "^6.1.0",
    "capacitor-bazaar-billing": "file:./plugins/capacitor-bazaar-billing"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21",
    "@capacitor/cli": "^7.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
